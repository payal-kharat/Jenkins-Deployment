
pipeline {

    agent any

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'qa', 'stage', 'prod'],
            description: 'Select environment'
        )
    }

    environment {

        /* =====================================================
           DOCKER HUB REGISTRIES
           ===================================================== */

        DEV_REGISTRY =
            "docker.io/payalkharat/jenkins-db-dev"

        QA_REGISTRY =
            "docker.io/payalkharat/jenkins-db-qa"

        STAGE_REGISTRY =
            "docker.io/payalkharat/jenkins-db-stage"

        PROD_REGISTRY =
            "docker.io/payalkharat/jenkins-db-prod"


        /* =====================================================
           AWS
           ===================================================== */

        AWS_REGION = "us-east-1"


        /* =====================================================
           ECS
           ===================================================== */

        DEV_CLUSTER =
            "employee-managemet-dev-cluster"

        QA_CLUSTER =
            "employee-managemet-qa-cluster"

        STAGE_CLUSTER =
            "employee-managemet-uat-cluster"

        PROD_CLUSTER =
            "employee-managemet-prod-cluster"


        DEV_SERVICE =
            "employee-managemet-dev-db-service"

        QA_SERVICE =
            "employee-managemet-qa-db-service"

        STAGE_SERVICE =
            "employee-managemet-uat-db-service"

        PROD_SERVICE =
            "employee-managemet-prod-db-service"


        DEV_TASK_FAMILY =
            "employee-managemet-dev-db"

        QA_TASK_FAMILY =
            "employee-managemet-qa-db"

        STAGE_TASK_FAMILY =
            "employee-managemet-uat-db"

        PROD_TASK_FAMILY =
            "employee-managemet-prod-db"


        /* =====================================================
           DB FILES
           ===================================================== */

        DOCKERFILE =
            "db/Dockerfile"

        BUILD_CONTEXT =
            "db"

        TASK_DEFINITION_TEMPLATE =
            "db/task-definition.json"


        /* =====================================================
           DOCKER HUB CREDENTIALS
           ===================================================== */

        DOCKER_CREDS =
            "Docker-hub-id"
    }


    stages {


        /* =====================================================
           CHECKOUT
           ===================================================== */

        stage('Checkout') {

            steps {

                checkout scm

                script {

                    env.COMMIT_ID = sh(
                        script: "git rev-parse --short HEAD",
                        returnStdout: true
                    ).trim()

                    echo "======================================"
                    echo "COMMIT ID: ${env.COMMIT_ID}"
                    echo "======================================"
                }
            }
        }


        /* =====================================================
           DOCKER LOGIN
           ===================================================== */

        stage('Docker Login') {

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: "${DOCKER_CREDS}",
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {

                    sh '''
                        echo "$DOCKER_PASSWORD" | docker login \
                            docker.io \
                            -u "$DOCKER_USERNAME" \
                            --password-stdin
                    '''
                }
            }
        }


        /* =====================================================
           BUILD DB IMAGE
           ===================================================== */

        stage('Build DB Image') {

            when {

                expression {
                    params.ENVIRONMENT == 'dev'
                }
            }

            steps {

                script {

                    def image =
                        "${DEV_REGISTRY}:${COMMIT_ID}"

                    echo "======================================"
                    echo "BUILDING DB IMAGE"
                    echo "======================================"
                    echo "Image: ${image}"
                    echo "======================================"


                    sh """
                        docker build \
                            -f ${DOCKERFILE} \
                            -t ${image} \
                            ${BUILD_CONTEXT}

                        docker push ${image}
                    """


                    echo "======================================"
                    echo "DB IMAGE BUILT AND PUSHED"
                    echo "Image: ${image}"
                    echo "======================================"
                }
            }
        }


        /* =====================================================
           DEPLOY DB - DEV
           ===================================================== */

        stage('Deploy DB - DEV') {

            when {

                expression {
                    params.ENVIRONMENT == 'dev'
                }
            }

            steps {

                script {

                    deployDB(
                        DEV_CLUSTER,
                        DEV_SERVICE,
                        DEV_TASK_FAMILY,
                        DEV_REGISTRY
                    )
                }
            }
        }


        /* =====================================================
           PROMOTE DEV → QA
           ===================================================== */

        stage('Promote DB DEV → QA') {

            when {

                expression {
                    params.ENVIRONMENT == 'qa'
                }
            }

            steps {

                script {

                    promoteImage(
                        "${DEV_REGISTRY}:${COMMIT_ID}",
                        "${QA_REGISTRY}:${COMMIT_ID}"
                    )
                }
            }
        }


        /* =====================================================
           DEPLOY DB - QA
           ===================================================== */

        stage('Deploy DB - QA') {

            when {

                expression {
                    params.ENVIRONMENT == 'qa'
                }
            }

            steps {

                script {

                    deployDB(
                        QA_CLUSTER,
                        QA_SERVICE,
                        QA_TASK_FAMILY,
                        QA_REGISTRY
                    )
                }
            }
        }


        /* =====================================================
           PROMOTE QA → STAGE
           ===================================================== */

        stage('Promote DB QA → STAGE') {

            when {

                expression {
                    params.ENVIRONMENT == 'stage'
                }
            }

            steps {

                script {

                    promoteImage(
                        "${QA_REGISTRY}:${COMMIT_ID}",
                        "${STAGE_REGISTRY}:${COMMIT_ID}"
                    )
                }
            }
        }


        /* =====================================================
           DEPLOY DB - STAGE
           ===================================================== */

        stage('Deploy DB - STAGE') {

            when {

                expression {
                    params.ENVIRONMENT == 'stage'
                }
            }

            steps {

                script {

                    deployDB(
                        STAGE_CLUSTER,
                        STAGE_SERVICE,
                        STAGE_TASK_FAMILY,
                        STAGE_REGISTRY
                    )
                }
            }
        }


        /* =====================================================
           PRODUCTION APPROVAL
           ===================================================== */

        stage('Production Approval') {

            when {

                expression {
                    params.ENVIRONMENT == 'prod'
                }
            }

            steps {

                input(
                    message: "Deploy DB ${COMMIT_ID} to PROD?",
                    ok: "Deploy DB to PROD"
                )
            }
        }


        /* =====================================================
           PROMOTE STAGE → PROD
           ===================================================== */

        stage('Promote DB STAGE → PROD') {

            when {

                expression {
                    params.ENVIRONMENT == 'prod'
                }
            }

            steps {

                script {

                    promoteImage(
                        "${STAGE_REGISTRY}:${COMMIT_ID}",
                        "${PROD_REGISTRY}:${COMMIT_ID}"
                    )
                }
            }
        }


        /* =====================================================
           DEPLOY DB - PROD
           ===================================================== */

        stage('Deploy DB - PROD') {

            when {

                expression {
                    params.ENVIRONMENT == 'prod'
                }
            }

            steps {

                script {

                    deployDB(
                        PROD_CLUSTER,
                        PROD_SERVICE,
                        PROD_TASK_FAMILY,
                        PROD_REGISTRY
                    )
                }
            }
        }
    }


    /* =========================================================
       POST
       ========================================================= */

    post {

        always {

            echo "Cleaning Jenkins workspace..."

            cleanWs()
        }
    }
}


/* =============================================================
   DB DEPLOYMENT FUNCTION
   ============================================================= */

def deployDB(
    String cluster,
    String service,
    String taskFamily,
    String registry
) {

    def image =
        "${registry}:${env.COMMIT_ID}"


    echo "======================================"
    echo "DEPLOYING DATABASE"
    echo "======================================"
    echo "Cluster    : ${cluster}"
    echo "Service    : ${service}"
    echo "Task Family: ${taskFamily}"
    echo "Image      : ${image}"
    echo "======================================"


    /*
     * Create a temporary task definition.
     */

    sh """
        set -e

        IMAGE="${image}" \
        TASK_FAMILY="${taskFamily}" \
        TEMPLATE="${env.TASK_DEFINITION_TEMPLATE}" \
        python3 - <<'PY'

import json
import os

template = os.environ["TEMPLATE"]
image = os.environ["IMAGE"]
task_family = os.environ["TASK_FAMILY"]

output = "new-db-task-definition.json"

with open(template, "r") as f:
    task_definition = json.load(f)

task_definition["family"] = task_family

for container in task_definition["containerDefinitions"]:

    if container["name"] == "db":
        container["image"] = image
        break

else:
    raise Exception("Container named 'db' was not found.")

with open(output, "w") as f:
    json.dump(task_definition, f, indent=2)

PY

        echo "Generated task definition:"
        cat new-db-task-definition.json
    """


    /*
     * Register task definition.
     *
     * IMPORTANT:
     * Revision is stored in a LOCAL Groovy variable.
     *
     * We do NOT use NEW_REVISION.
     */

    def revision = sh(
        script: """
            set -e

            aws ecs register-task-definition \
                --cli-input-json file://new-db-task-definition.json \
                --region ${env.AWS_REGION} \
                --query 'taskDefinition.revision' \
                --output text
        """,
        returnStdout: true
    ).trim()


    echo "======================================"
    echo "AWS REGISTERED REVISION: '${revision}'"
    echo "======================================"


    if (!revision ||
        revision == "null" ||
        revision == "None") {

        error(
            "Invalid ECS revision returned by AWS: '${revision}'"
        )
    }


    /*
     * Update ECS service.
     */

    echo "Updating ECS service..."

    sh """
        set -e

        aws ecs update-service \
            --cluster ${cluster} \
            --service ${service} \
            --task-definition ${taskFamily}:${revision} \
            --force-new-deployment \
            --region ${env.AWS_REGION}
    """


    /*
     * Wait until ECS service becomes stable.
     */

    echo "Waiting for ECS service to become stable..."

    sh """
        aws ecs wait services-stable \
            --cluster ${cluster} \
            --services ${service} \
            --region ${env.AWS_REGION}
    """


    /*
     * Show ECS service status.
     */

    echo "ECS Service Status:"

    sh """
        aws ecs describe-services \
            --cluster ${cluster} \
            --services ${service} \
            --region ${env.AWS_REGION} \
            --query 'services[0].{Status:status,Desired:desiredCount,Running:runningCount,Pending:pendingCount,TaskDefinition:taskDefinition}' \
            --output table
    """


    echo "======================================"
    echo "DATABASE DEPLOYMENT COMPLETED"
    echo "======================================"
    echo "Cluster    : ${cluster}"
    echo "Service    : ${service}"
    echo "Task Family: ${taskFamily}"
    echo "Revision   : ${revision}"
    echo "Image      : ${image}"
    echo "======================================"
}


/* =============================================================
   IMAGE PROMOTION FUNCTION
   ============================================================= */

def promoteImage(
    String sourceImage,
    String targetImage
) {

    echo "======================================"
    echo "IMAGE PROMOTION"
    echo "======================================"
    echo "Source : ${sourceImage}"
    echo "Target : ${targetImage}"
    echo "======================================"


    /*
     * Pull source image.
     */

    withCredentials([
        usernamePassword(
            credentialsId: "${env.DOCKER_CREDS}",
            usernameVariable: 'DOCKER_USERNAME',
            passwordVariable: 'DOCKER_PASSWORD'
        )
    ]) {

        sh """
            echo "\$DOCKER_PASSWORD" | docker login \
                docker.io \
                -u "\$DOCKER_USERNAME" \
                --password-stdin

            docker pull ${sourceImage}
        """
    }


    /*
     * Retag the exact same image.
     */

    sh """
        docker tag \
            ${sourceImage} \
            ${targetImage}
    """


    /*
     * Push target image.
     */

    withCredentials([
        usernamePassword(
            credentialsId: "${env.DOCKER_CREDS}",
            usernameVariable: 'DOCKER_USERNAME',
            passwordVariable: 'DOCKER_PASSWORD'
        )
    ]) {

        sh """
            echo "\$DOCKER_PASSWORD" | docker login \
                docker.io \
                -u "\$DOCKER_USERNAME" \
                --password-stdin

            docker push ${targetImage}
        """
    }


    /*
     * Clean local Docker images.
     */

    sh """
        docker rmi ${sourceImage} || true
        docker rmi ${targetImage} || true
    """


    echo "======================================"
    echo "IMAGE PROMOTION COMPLETED"
    echo "======================================"
    echo "Source : ${sourceImage}"
    echo "Target : ${targetImage}"
    echo "======================================"
}
