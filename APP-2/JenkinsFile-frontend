pipeline {

```
agent any

environment {

    DEV_REGISTRY =
        "docker.io/payalkharat/jenkins-frontend-dev"

    QA_REGISTRY =
        "docker.io/payalkharat/jenkins-frontend-qa"

    STAGE_REGISTRY =
        "docker.io/payalkharat/jenkins-frontend-uat"

    PROD_REGISTRY =
        "docker.io/payalkharat/jenkins-frontend-prod"


    EKS_CLUSTER = "cluster-1"
    AWS_REGION  = "us-east-1"


    DEV_NAMESPACE   = "dev"
    QA_NAMESPACE    = "qa"
    STAGE_NAMESPACE = "uat"
    PROD_NAMESPACE  = "prod"


    DEV_DOCKER_CREDS   = "dh_cred_dev"
    QA_DOCKER_CREDS    = "dh_cred_qa"
    STAGE_DOCKER_CREDS = "dh_cred_stage"
    PROD_DOCKER_CREDS  = "dh_cred_prod"
}


stages {

    /* ======================================================
       CHECKOUT
       ====================================================== */

    stage('Checkout') {

        steps {

            checkout scm

            script {

                env.COMMIT_ID = sh(
                    script: "git rev-parse --short HEAD",
                    returnStdout: true
                ).trim()

                echo "======================================"
                echo "COMMIT ID: ${env.COMMIT_ID}"
                echo "======================================"
            }
        }
    }


    /* ======================================================
       CONNECT TO EKS
       ====================================================== */

    stage('Connect to EKS') {

        steps {

            sh """
                aws eks update-kubeconfig \
                    --name ${EKS_CLUSTER} \
                    --region ${AWS_REGION}

                kubectl get nodes
            """
        }
    }


    /* ======================================================
       DOCKER LOGIN
       ====================================================== */

    stage('Docker Login') {

        steps {

            withCredentials([
                usernamePassword(
                    credentialsId: 'Docker-hub-id',
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASSWORD'
                )
            ]) {

                sh '''
                    echo "$DOCKER_PASSWORD" | docker login \
                        docker.io \
                        -u "$DOCKER_USERNAME" \
                        --password-stdin
                '''
            }
        }
    }


    /* ======================================================
       BUILD FRONTEND IMAGE
       ====================================================== */

    stage('Build Frontend Image') {

        steps {

            script {

                def image =
                    "${DEV_REGISTRY}:${COMMIT_ID}"

                sh """
                    docker build \
                        -f APP-2/nginx-golang-mysql/proxy/Dockerfile \
                        -t ${image} \
                        APP-2/nginx-golang-mysql/proxy/

                    docker push ${image}
                """

                echo "======================================"
                echo "FRONTEND IMAGE BUILT AND PUSHED"
                echo "IMAGE: ${image}"
                echo "======================================"
            }
        }
    }


    /* ======================================================
       DEPLOY FRONTEND - DEV
       ====================================================== */

    stage('Deploy Frontend - DEV') {

        steps {

            script {

                deployFrontend(
                    DEV_NAMESPACE,
                    DEV_REGISTRY,
                    "APP-2/kube/frontend-deployment.yaml",
                    "APP-2/kube/frontend-service.yaml",
                    "APP-2/kube/ingress.yaml"
                )
            }
        }
    }


    /* ======================================================
       PROMOTE DEV → QA
       ====================================================== */

    stage('Promote Frontend DEV → QA') {

        steps {

            script {

                promoteImage(
                    "${DEV_REGISTRY}:${COMMIT_ID}",
                    "${QA_REGISTRY}:${COMMIT_ID}",
                    DEV_DOCKER_CREDS,
                    QA_DOCKER_CREDS
                )
            }
        }
    }


    /* ======================================================
       DEPLOY FRONTEND - QA
       ====================================================== */

    stage('Deploy Frontend - QA') {

        steps {

            script {

                deployFrontend(
                    QA_NAMESPACE,
                    QA_REGISTRY,
                    "APP-2/kube/frontend-deployment.yaml",
                    "APP-2/kube/frontend-service.yaml",
                    "APP-2/kube/ingress.yaml"
                )
            }
        }
    }


    /* ======================================================
       PROMOTE QA → STAGE
       ====================================================== */

    stage('Promote Frontend QA → STAGE') {

        steps {

            script {

                promoteImage(
                    "${QA_REGISTRY}:${COMMIT_ID}",
                    "${STAGE_REGISTRY}:${COMMIT_ID}",
                    QA_DOCKER_CREDS,
                    STAGE_DOCKER_CREDS
                )
            }
        }
    }


    /* ======================================================
       DEPLOY FRONTEND - STAGE
       ====================================================== */

    stage('Deploy Frontend - STAGE') {

        steps {

            script {

                deployFrontend(
                    STAGE_NAMESPACE,
                    STAGE_REGISTRY,
                    "APP-2/kube/frontend-deployment.yaml",
                    "APP-2/kube/frontend-service.yaml",
                    "APP-2/kube/ingress.yaml"
                )
            }
        }
    }


    /* ======================================================
       PRODUCTION APPROVAL
       ====================================================== */

    stage('Production Approval') {

        steps {

            input(
                message: "Deploy Frontend ${COMMIT_ID} to PROD?",
                ok: "Deploy Frontend to PROD"
            )
        }
    }


    /* ======================================================
       PROMOTE STAGE → PROD
       ====================================================== */

    stage('Promote Frontend STAGE → PROD') {

        steps {

            script {

                promoteImage(
                    "${STAGE_REGISTRY}:${COMMIT_ID}",
                    "${PROD_REGISTRY}:${COMMIT_ID}",
                    STAGE_DOCKER_CREDS,
                    PROD_DOCKER_CREDS
                )
            }
        }
    }


    /* ======================================================
       DEPLOY FRONTEND - PROD
       ====================================================== */

    stage('Deploy Frontend - PROD') {

        steps {

            script {

                deployFrontend(
                    PROD_NAMESPACE,
                    PROD_REGISTRY,
                    "APP-2/kube/frontend-deployment.yaml",
                    "APP-2/kube/frontend-service.yaml",
                    "APP-2/kube/ingress.yaml"
                )
            }
        }
    }
}


/* =========================================================
   POST
   ========================================================= */

post {

    always {

        echo "Cleaning Jenkins workspace..."

        cleanWs()
    }
}
