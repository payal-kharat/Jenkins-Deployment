/* =========================================================
FRONTEND DEPLOYMENT FUNCTION
========================================================= */

def deployFrontend(
String namespace,
String registry,
String deploymentYaml,
String serviceYaml,
String ingressYaml
) {

```
def image =
    "${registry}:${env.COMMIT_ID}"


echo "======================================"
echo "DEPLOYING FRONTEND"
echo "======================================"

echo "Namespace : ${namespace}"
echo "Image     : ${image}"
echo "Deployment: ${deploymentYaml}"
echo "Service   : ${serviceYaml}"
echo "Ingress   : ${ingressYaml}"

echo "======================================"


/* ------------------------------------------------------
   FRONTEND DEPLOYMENT
   ------------------------------------------------------ */

echo "Applying Frontend Deployment..."

sh """
    kubectl apply \
        -f ${deploymentYaml} \
        -n ${namespace}
"""


/* ------------------------------------------------------
   FRONTEND SERVICE
   ------------------------------------------------------ */

echo "Applying Frontend Service..."

sh """
    kubectl apply \
        -f ${serviceYaml} \
        -n ${namespace}
"""


/* ------------------------------------------------------
   FRONTEND INGRESS
   ------------------------------------------------------ */

echo "Applying Frontend Ingress..."

sh """
    kubectl apply \
        -f ${ingressYaml} \
        -n ${namespace}
"""


/* ------------------------------------------------------
   UPDATE FRONTEND IMAGE
   ------------------------------------------------------ */

echo "Updating Frontend Image..."

sh """
    kubectl -n ${namespace} set image \
        deployment/frontend \
        frontend=${image}
"""


/* ------------------------------------------------------
   WAIT FOR ROLLOUT
   ------------------------------------------------------ */

echo "Waiting for Frontend Rollout..."

sh """
    kubectl -n ${namespace} rollout status \
        deployment/frontend \
        --timeout=180s
"""


/* ------------------------------------------------------
   VERIFICATION
   ------------------------------------------------------ */

echo "======================================"
echo "FRONTEND DEPLOYMENT STATUS"
echo "======================================"


sh """

    echo "===== DEPLOYMENT ====="

    kubectl get deployment frontend \
        -n ${namespace}


    echo "===== SERVICE ====="

    kubectl get service app2-frontend \
        -n ${namespace}


    echo "===== INGRESS ====="

    kubectl get ingress app2-ingress \
        -n ${namespace}


    echo "===== PODS ====="

    kubectl get pods \
        -n ${namespace} \
        -o wide
"""


echo "======================================"
echo "FRONTEND DEPLOYMENT COMPLETED"
echo "======================================"
```

}

/* =========================================================
IMAGE PROMOTION FUNCTION
========================================================= */

def promoteImage(
String sourceImage,
String targetImage,
String sourceCredentials,
String targetCredentials
) {

```
echo "======================================"
echo "IMAGE PROMOTION"
echo "======================================"

echo "Source : ${sourceImage}"
echo "Target : ${targetImage}"

echo "======================================"


/* ------------------------------------------------------
   LOGIN TO SOURCE REGISTRY
   ------------------------------------------------------ */

withCredentials([
    usernamePassword(
        credentialsId: sourceCredentials,
        usernameVariable: 'DOCKER_USERNAME',
        passwordVariable: 'DOCKER_PASSWORD'
    )
]) {

    sh """
        echo "\$DOCKER_PASSWORD" | docker login \
            docker.io \
            -u "\$DOCKER_USERNAME" \
            --password-stdin

        docker pull ${sourceImage}
    """
}


/* ------------------------------------------------------
   RETAG EXISTING IMAGE
   ------------------------------------------------------ */

sh """
    docker tag \
        ${sourceImage} \
        ${targetImage}
"""


/* ------------------------------------------------------
   LOGIN TO TARGET REGISTRY
   ------------------------------------------------------ */

withCredentials([
    usernamePassword(
        credentialsId: targetCredentials,
        usernameVariable: 'DOCKER_USERNAME',
        passwordVariable: 'DOCKER_PASSWORD'
    )
]) {

    sh """
        echo "\$DOCKER_PASSWORD" | docker login \
            docker.io \
            -u "\$DOCKER_USERNAME" \
            --password-stdin

        docker push ${targetImage}
    """
}


/* ------------------------------------------------------
   REMOVE LOCAL COPIES
   ------------------------------------------------------ */

sh """
    docker rmi ${sourceImage} || true
    docker rmi ${targetImage} || true
"""


echo "======================================"
echo "IMAGE PROMOTION COMPLETED"
echo "======================================"
```

