
pipeline {

    agent any

    environment {

        DEV_REGISTRY =
            "docker.io/payalkharat/jenkins-db-dev"

        QA_REGISTRY =
            "docker.io/payalkharat/jenkins-db-qa"

        STAGE_REGISTRY =
            "docker.io/payalkharat/jenkins-db-uat"

        PROD_REGISTRY =
            "docker.io/payalkharat/jenkins-db-prod"

        EKS_CLUSTER = "cluster-1"
        AWS_REGION  = "us-east-1"

        DEV_NAMESPACE   = "dev"
        QA_NAMESPACE    = "qa"
        STAGE_NAMESPACE = "uat"
        PROD_NAMESPACE  = "prod"

        DEV_DOCKER_CREDS   = "dh_cred_dev"
        QA_DOCKER_CREDS    = "dh_cred_qa"
        STAGE_DOCKER_CREDS = "dh_cred_stage"
        PROD_DOCKER_CREDS  = "dh_cred_prod"
    }


    stages {

        stage('Connect to EKS') {

            steps {

                sh """
                    aws eks update-kubeconfig \
                        --name ${EKS_CLUSTER} \
                        --region ${AWS_REGION}

                    kubectl get nodes
                """
            }
        }

        stage('Create Kubernetes Namespaces') {

            steps {

                sh """
                    kubectl get namespace ${DEV_NAMESPACE} \
                    || kubectl create namespace ${DEV_NAMESPACE}

                    kubectl get namespace ${QA_NAMESPACE} \
                    || kubectl create namespace ${QA_NAMESPACE}

                    kubectl get namespace ${STAGE_NAMESPACE} \
                    || kubectl create namespace ${STAGE_NAMESPACE}

                    kubectl get namespace ${PROD_NAMESPACE} \
                    || kubectl create namespace ${PROD_NAMESPACE}
                """
            }
        }

        stage('Docker Login') {

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'Docker-hub-id',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {

                    sh '''
                        echo "$DOCKER_PASSWORD" | docker login \
                            -u "$DOCKER_USERNAME" \
                            --password-stdin docker.io
                    '''
                }
            }
        }

        stage('Build DB Image') {

            steps {

                script {

                    def image =
                        "${DEV_REGISTRY}:${COMMIT_ID}"

                    sh """
                        docker build \
                            -f APP-4/react-rust-postgres/db/Dockerfile \
                            -t ${image} \
                            APP-4/react-rust-postgres/db/

                        docker push ${image}
                    """

                    echo "DB image pushed:"
                    echo "${image}"
                }
            }
        }
        stage('Deploy DB - DEV') {

            steps {

                script {

                    deployDB(
                        DEV_NAMESPACE,
                        DEV_REGISTRY,

                        "APP-4/kube/db-secret.yaml",
                        "APP-4/kube/db-configmap.yaml",
                        "APP-4/kube/db-storageclass.yaml",
                        "APP-4/kube/db-pvc.yaml",
                        "APP-4/kube/db-deployment.yaml",
                        "APP-4/kube/db-service.yaml"
                    )
                }
            }
        }

        stage('Promote DB DEV → QA') {

            steps {

                script {

                    promoteImage(
                        "${DEV_REGISTRY}:${COMMIT_ID}",
                        "${QA_REGISTRY}:${COMMIT_ID}",
                        DEV_DOCKER_CREDS,
                        QA_DOCKER_CREDS
                    )
                }
            }
        }

        stage('Deploy DB - QA') {

            steps {

                script {

                    deployDB(
                        QA_NAMESPACE,
                        QA_REGISTRY,

                        "APP-4/kube/db-secret.yaml",
                        "APP-4/kube/db-configmap.yaml",
                        "APP-4/kube/db-storageclass.yaml",
                        "APP-4/kube/db-pvc.yaml",
                        "APP-4/kube/db-deployment.yaml",
                        "APP-4/kube/db-service.yaml"
                    )
                }
            }
        }

        stage('Promote DB QA → STAGE') {

            steps {

                script {

                    promoteImage(
                        "${QA_REGISTRY}:${COMMIT_ID}",
                        "${STAGE_REGISTRY}:${COMMIT_ID}",
                        QA_DOCKER_CREDS,
                        STAGE_DOCKER_CREDS
                    )
                }
            }
        }
        stage('Deploy DB - STAGE') {

            steps {

                script {

                    deployDB(
                        STAGE_NAMESPACE,
                        STAGE_REGISTRY,

                        "APP-4/kube/db-secret.yaml",
                        "APP-4/kube/db-configmap.yaml",
                        "APP-4/kube/db-storageclass.yaml",
                        "APP-4/kube/db-pvc.yaml",
                        "APP-4/kube/db-deployment.yaml",
                        "APP-4/kube/db-service.yaml"
                    )
                }
            }
        }

        stage('Production Approval') {

            steps {

                input(
                    message: "Deploy DB ${COMMIT_ID} to PROD?",
                    ok: "Deploy DB to PROD"
                )
            }
        }
        stage('Promote DB STAGE → PROD') {

            steps {

                script {

                    promoteImage(
                        "${STAGE_REGISTRY}:${COMMIT_ID}",
                        "${PROD_REGISTRY}:${COMMIT_ID}",
                        STAGE_DOCKER_CREDS,
                        PROD_DOCKER_CREDS
                    )
                }
            }
        }

        stage('Deploy DB - PROD') {

            steps {

                script {

                    deployDB(
                        PROD_NAMESPACE,
                        PROD_REGISTRY,

                        "APP-4/kube/db-secret.yaml",
                        "APP-4/kube/db-configmap.yaml",
                        "APP-4/kube/db-storageclass.yaml",
                        "APP-4/kube/db-pvc.yaml",
                        "APP-4/kube/db-deployment.yaml",
                        "APP-4/kube/db-service.yaml"
                    )
                }
            }
        }
    }

    post {

        always {

            echo "Cleaning Jenkins workspace..."

            cleanWs()
        }
    }
}

def deployDB(
    String namespace,
    String registry,
    String secretYaml,
    String configMapYaml,
    String storageclassYaml,
    String pvcYaml,
    String deploymentYaml,
    String serviceYaml
) {

    def image =
        "${registry}:${env.COMMIT_ID}"

    echo "Namespace      : ${namespace}"
    echo "Image          : ${image}"
    echo "StorageClass   : ${storageclassYaml}"
    echo "PVC            : ${pvcYaml}"
    echo "Deployment     : ${deploymentYaml}"
    echo "Service        : ${serviceYaml}"

    sh """
        kubectl apply \
            -f ${storageclassYaml}
    """

    sh """
        kubectl apply \
            -f ${secretYaml} \
            -n ${namespace}
    """

    sh """
        kubectl apply \
            -f ${configMapYaml} \
            -n ${namespace}
    """


    

    sh """
        kubectl apply \
            -f ${pvcYaml} \
            -n ${namespace}
    """

    sh """
        kubectl apply \
            -f ${deploymentYaml} \
            -n ${namespace}
    """

    sh """
        kubectl apply \
            -f ${serviceYaml} \
            -n ${namespace}
    """

    sh """
        kubectl -n ${namespace} set image \
            deployment/mysql \
            mysql=${image}
    """

    sh """
        kubectl -n ${namespace} rollout status \
            deployment/mysql \
            --timeout=300s
    """

    sh """

        kubectl get storageclass

        kubectl get secret \
            -n ${namespace}

        kubectl get configmap \
            -n ${namespace}

        kubectl get pvc \
            -n ${namespace}

        kubectl get deployment mysql \
            -n ${namespace}

        kubectl get service app4-db \
            -n ${namespace}

        kubectl get pods \
            -n ${namespace} \
            -o wide
    """
}

def promoteImage(
    String sourceImage,
    String targetImage,
    String sourceCredentials,
    String targetCredentials
) {


    echo "Source : ${sourceImage}"
    echo "Target : ${targetImage}"

    withCredentials([
        usernamePassword(
            credentialsId: sourceCredentials,
            usernameVariable: 'DOCKER_USERNAME',
            passwordVariable: 'DOCKER_PASSWORD'
        )
    ]) {

        sh """
            echo "\$DOCKER_PASSWORD" | docker login \
                docker.io \
                -u "\$DOCKER_USERNAME" \
                --password-stdin

            docker pull ${sourceImage}
        """
    }


    sh """
        docker tag \
            ${sourceImage} \
            ${targetImage}
    """

    withCredentials([
        usernamePassword(
            credentialsId: targetCredentials,
            usernameVariable: 'DOCKER_USERNAME',
            passwordVariable: 'DOCKER_PASSWORD'
        )
    ]) {

        sh """
            echo "\$DOCKER_PASSWORD" | docker login \
                docker.io \
                -u "\$DOCKER_USERNAME" \
                --password-stdin

            docker push ${targetImage}
        """
    }

    sh """

        docker rmi ${sourceImage} || true

        docker rmi ${targetImage} || true
    """
}